# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=worktrack

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_HASH_SECRET=your_refresh_token_hash_secret
# Optional: how long a just-rotated refresh token is treated as a legitimate
# concurrent refresh instead of token reuse. Defaults to 30s.
REFRESH_TOKEN_REUSE_GRACE_MS=30s

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
