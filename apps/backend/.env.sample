# WorkTrack backend environment.
# Copy to `.env` and fill in. Values shown are the local Docker defaults.
# "required" means the app refuses to start without it (see src/config/env.validation.ts).

# --- Server ---------------------------------------------------------------
NODE_ENV=development                      # optional: development | production | test
PORT=3001                                 # optional, default 3001
# ENABLE_SWAGGER=true                     # optional — /api/docs is on outside production;
                                          # set this to publish it in production too
FRONTEND_URL=http://localhost:3000        # required — also the CORS allow-list; comma-separate several

# How many proxies are in front of the app. One for a normal host like Render.
# Setting it higher than the truth lets clients fake their IP and dodge the
# rate limits.
TRUST_PROXY_HOPS=1                        # optional, default 1

# --- Database -------------------------------------------------------------
# Either set DATABASE_URL on its own, or the five DB_* values below.
# Hosted Postgres (Neon, Render, Railway) gives you a URL; Docker uses DB_*.
# DATABASE_URL=postgres://user:password@host:5432/worktrack?sslmode=verify-full
# DATABASE_SSL=true                       # optional, default false — enable TLS for hosted databases

DB_HOST=db                                # required unless DATABASE_URL is set
DB_PORT=5432                              # optional, default 5432
DB_USERNAME=worktrack                     # required unless DATABASE_URL is set
DB_PASSWORD=worktrack                     # required unless DATABASE_URL is set
DB_NAME=worktrack                         # required unless DATABASE_URL is set

# --- Tokens ---------------------------------------------------------------
# The three secrets must each be at least 32 characters. Use different values
# per environment: a staging token must never be valid in production.
ACCESS_TOKEN_SECRET=change_me_at_least_32_characters_long        # required
REFRESH_TOKEN_SECRET=change_me_at_least_32_characters_long       # required
REFRESH_TOKEN_HASH_SECRET=change_me_at_least_32_characters_long  # required

ACCESS_TOKEN_EXPIRES_IN=15m               # optional, default 15m
REFRESH_TOKEN_EXPIRES_IN=30d              # optional, default 30d
REFRESH_TOKEN_REUSE_GRACE_MS=30s          # optional, default 30s — window where a just-rotated
                                          # token still counts as a concurrent refresh, not reuse
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m       # optional, default 15m
INVITATION_EXPIRES_IN=1d                  # optional, default 1d

# --- Auth cookies ---------------------------------------------------------
AUTH_COOKIE_SAMESITE=lax                  # optional: lax | strict | none. Use none for cross-site HTTPS
AUTH_COOKIE_SECURE=false                  # optional, default false. Must be true over HTTPS

# --- Google OAuth ---------------------------------------------------------
# Register all callback URLs in the Google Cloud console.
#
# These callbacks intentionally point to the frontend proxy rather than the
# backend directly. This keeps Google auth cookies on the frontend origin
# when frontend and backend are deployed on different hosts.
GOOGLE_CLIENT_ID=your_google_client_id             # required
GOOGLE_CLIENT_SECRET=your_google_client_secret     # required
GOOGLE_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/callback                    # required
GOOGLE_SIGNUP_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/signup/callback      # required
GOOGLE_LINK_CALLBACK_URL=http://localhost:3000/api/backend/auth/google/link/callback          # required
GOOGLE_INVITATION_CALLBACK_URL=http://localhost:3000/api/backend/invitations/google/callback  # required

GOOGLE_TOKEN_EXPIRES_IN=5m                # optional, default 1m
GOOGLE_OAUTH_STATE_EXPIRES_IN=10m         # optional, default 10m

# --- Mail (Resend) --------------------------------------------------------
RESEND_API_KEY=your_resend_api_key                # required
MAIL_FROM=WorkTrack <onboarding@resend.dev>       # required

# --- Seeding (local only) -------------------------------------------------
TEST_OWNER_EMAIL=owner@worktrack.test     # optional — the owner account `make seed` creates
