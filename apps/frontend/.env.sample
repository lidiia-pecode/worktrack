# WorkTrack frontend environment. Copy to `.env` and fill in.

# Where the frontend reaches the backend.
#
# BACKEND_URL is server-side only and is read by next.config.ts at BUILD time,
# so it must be set when the app is built, not just when it runs.
# Inside Docker the backend is reachable by service name; elsewhere use its URL.
BACKEND_URL=http://backend:3001                   # required

# Same backend, but as the browser sees it. Used for the Google sign-in links,
# which leave the app instead of going through the /api/backend proxy.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001     # required
