# WorkTrack frontend environment. Copy to `.env` and fill in.

# Backend URL used by Next.js at build time.
#
# This is server-side only. The browser calls /api/backend/* on the frontend
# origin, and the Next.js rewrite forwards those requests to the backend.
# Locally the backend runs on this machine at port 3001.

BACKEND_URL=http://localhost:3001                 # required
