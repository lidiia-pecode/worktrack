FROM node:22-alpine

WORKDIR /app

# workspace manifests
COPY package.json package-lock.json ./
COPY apps/frontend/package.json ./apps/frontend/package.json

# install workspace dependencies
RUN npm ci

EXPOSE 3000

WORKDIR /app/apps/frontend

# Webpack instead of Turbopack: Turbopack's polling misses file changes in the
# container (Next 16.2.1). Production builds still use Turbopack.
CMD ["npm", "run", "dev", "--", "--webpack", "--hostname", "0.0.0.0"]
